{
  "expo": {
    "name": "Expo UI Atlas",
    "slug": "expo-ui-atlas",
    "scheme": "expo-ui-atlas",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrewbierman.expouiatlas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#e6f3ec"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0ca59813-75c5-4dbe-a187-e038edf508d1"
      }
    },
    "owner": "andrewbierman"
  }
}
