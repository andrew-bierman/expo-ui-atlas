{
  "name": "expo-ui-atlas",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@ronradtke/react-native-markdown-display": "8.1.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.4.7",
    "punycode": "^2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.20",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9",
    "eslint-plugin-react-native": "^5.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "docs:sync": "bun scripts/sync-reference.ts",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "biome check . && eslint src",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android",
    "test:e2e": "bash scripts/test-e2e.sh"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
